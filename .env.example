# ============================================================
# DHAHABU — XAUUSD Trading Intelligence Platform
# Environment Configuration
# ============================================================

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/dhahabu
DATABASE_SYNC_URL=postgresql://postgres:password@localhost:5432/dhahabu

# ----- Market Data -----
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# ----- Telegram -----
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ----- Trading Config -----
ACCOUNT_BALANCE=10000.0
MAX_DAILY_LOSS_PCT=0.03
MAX_SIMULTANEOUS_TRADES=5
MAX_ACCOUNT_RISK_PCT=0.10
DEFAULT_RISK_PER_TRADE_PCT=0.01
RISK_FREE_RATE=0.045

# ----- Self-Healing Config -----
BACKTEST_INTERVAL_HOURS=4
PARAM_SEARCH_INTERVAL_HOURS=6
BRAIN_INTERVAL_MINUTES=30
ROLLING_WINDOWS_DAYS=7,14,30,60
WALK_FORWARD_TRAIN_RATIO=0.80
WALK_FORWARD_TEST_RATIO=0.20
OOS_PROFIT_FACTOR_THRESHOLD=0.70
OOS_EXPECTANCY_THRESHOLD=0.60
OOS_DRAWDOWN_EXPANSION_THRESHOLD=1.50
OOS_WIN_RATE_COLLAPSE_THRESHOLD=0.60
MONTE_CARLO_SIMULATIONS=1000
MONTE_CARLO_ROBUSTNESS_THRESHOLD=0.55
PARAM_SEARCH_COMBINATIONS=80
CONSECUTIVE_STOP_LOSSES_LIMIT=8
SHUTDOWN_DURATION_HOURS=24
AUTO_RESET_AFTER_SHUTDOWN=true

# ----- API Config -----
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-minimum-32-chars

# ----- Railway / Deployment -----
RAILWAY_ENVIRONMENT=production
PORT=8000

# ----- Frontend -----
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
