# ============================================================
# DHAHABU — XAUUSD Trading Intelligence Platform
# Environment Configuration
# ============================================================

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/dhahabu
DATABASE_SYNC_URL=postgresql://postgres:password@localhost:5432/dhahabu

# ----- Market Data -----
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# ----- Broker -----
# BROKER_MODE=paper              → simulation only (default, safe for testing)
# BROKER_MODE=oanda              → live/practice execution via OANDA v20 REST API
# BROKER_MODE=ctrader            → live/demo execution via cTrader Open API
#                                  (Pepperstone, IC Markets, FXPro, etc.)
#
# --- OANDA setup ---
#   1. Create a free practice account at https://fxpractice.oanda.com
#   2. Go to Manage Funds → API Access → Generate Token
#   3. Copy your Account ID from the dashboard
#
# --- cTrader setup (Pepperstone / IC Markets / any cTrader broker) ---
#   Step 1 — Register a developer application (free):
#     https://openapi.ctrader.com → "Create Application"
#     → You receive CTRADER_CLIENT_ID and CTRADER_CLIENT_SECRET
#
#   Step 2 — Authorise your trading account (OAuth flow):
#     Open this URL in your browser (replace YOUR_CLIENT_ID):
#     https://connect.spotware.com/apps/YOUR_CLIENT_ID/auth
#       ?redirect_uri=https://localhost
#       &scope=trading
#       &response_type=code
#     Log in with your cTrader ID → you get an auth code in the redirect URL
#
#   Step 3 — Exchange the auth code for an access token:
#     POST https://connect.spotware.com/apps/token
#       grant_type=authorization_code
#       code=<auth_code>
#       redirect_uri=https://localhost
#       client_id=<YOUR_CLIENT_ID>
#       client_secret=<YOUR_CLIENT_SECRET>
#     → Response contains access_token (set as CTRADER_ACCESS_TOKEN)
#
#   Step 4 — Find your account ID:
#     In the cTrader desktop app: Menu → Account Info → copy the numeric ID
#     Or call GET https://connect.spotware.com/apps/ACCOUNT_ID/tradeaccounts
#
BROKER_MODE=paper
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=001-001-0000000-001
OANDA_ENVIRONMENT=practice
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCOUNT_ID=
CTRADER_ACCESS_TOKEN=
CTRADER_ENVIRONMENT=demo

# ----- Telegram -----
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ----- Trading Config -----
ACCOUNT_BALANCE=10000.0
MAX_DAILY_LOSS_PCT=0.03
MAX_SIMULTANEOUS_TRADES=5
MAX_ACCOUNT_RISK_PCT=0.10
DEFAULT_RISK_PER_TRADE_PCT=0.01
RISK_FREE_RATE=0.045

# ----- Self-Healing Config -----
BACKTEST_INTERVAL_HOURS=4
PARAM_SEARCH_INTERVAL_HOURS=6
BRAIN_INTERVAL_MINUTES=30
ROLLING_WINDOWS_DAYS=7,14,30,60
WALK_FORWARD_TRAIN_RATIO=0.80
WALK_FORWARD_TEST_RATIO=0.20
OOS_PROFIT_FACTOR_THRESHOLD=0.70
OOS_EXPECTANCY_THRESHOLD=0.60
OOS_DRAWDOWN_EXPANSION_THRESHOLD=1.50
OOS_WIN_RATE_COLLAPSE_THRESHOLD=0.60
MONTE_CARLO_SIMULATIONS=1000
MONTE_CARLO_ROBUSTNESS_THRESHOLD=0.55
PARAM_SEARCH_COMBINATIONS=80
CONSECUTIVE_STOP_LOSSES_LIMIT=8
SHUTDOWN_DURATION_HOURS=24
AUTO_RESET_AFTER_SHUTDOWN=true

# ----- API Config -----
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-minimum-32-chars

# ----- Railway / Deployment -----
RAILWAY_ENVIRONMENT=production
PORT=8000

# ----- Frontend -----
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
